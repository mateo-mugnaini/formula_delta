# Formula Delta local configuration

# Backend listener
FORMULA_DELTA_HOST=127.0.0.1
FORMULA_DELTA_PORT=3000

# Formula 1 upstream endpoint (verify during Phase 0)
F1_SIGNALR_URL=https://livetiming.formula1.com/signalrcore
# Comma-separated hub topics. Leave empty until verified with the probe.
F1_SIGNALR_TOPICS=SessionInfo,SessionStatus,DriverList,TimingData,TimingAppData,TrackStatus,RaceControlMessages,WeatherData,LapCount,TeamRadio
# Experimental map/telemetry topics: add only after the probe verifies them.
# F1_SIGNALR_TOPICS=SessionInfo,SessionStatus,DriverList,TimingData,TimingAppData,TrackStatus,RaceControlMessages,WeatherData,LapCount,TeamRadio,Position.z,CarData.z

# Local storage
FORMULA_DELTA_RECORDINGS_DIR=./recordings

# Presentation delay in milliseconds
FORMULA_DELTA_DELAY_MS=0

# Logging: silent, error, warn, info, debug
FORMULA_DELTA_LOG_LEVEL=info
FORMULA_DELTA_RACE_CONTROL_CATALOG=output/race-control-glossary.json
